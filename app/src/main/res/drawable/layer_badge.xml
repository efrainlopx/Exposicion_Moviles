<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/palette_demo_surface" />
            <corners android:radius="28dp" />
            <stroke
                android:width="2dp"
                android:color="@color/palette_primary" />
        </shape>
    </item>
    <item
        android:top="12dp"
        android:right="12dp"
        android:gravity="top|end">
        <shape android:shape="oval">
            <size
                android:width="22dp"
                android:height="22dp" />
            <solid android:color="@color/palette_accent" />
        </shape>
    </item>
</layer-list>
