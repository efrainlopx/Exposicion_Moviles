<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.example.exposicion_moviles.ui.topic.views.ZoomableVectorImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@color/palette_demo_surface"
        android:contentDescription="Vector demo"
        android:padding="24dp"
        android:src="@drawable/ic_vector_demo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Haz zoom con dos dedos: el vector escala sin perder calidad."
        android:textColor="@color/palette_text_secondary" />
</LinearLayout>
